{
  "name": "so-no-be",
  "version": "0.1.0",
  "private": true,
  "description": "Sổ Nợ — backend API (Next.js Route Handlers + MongoDB)",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
