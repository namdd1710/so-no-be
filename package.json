  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "mongodb-memory-server": "^11.3.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
