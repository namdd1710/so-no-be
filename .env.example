# ---------- MongoDB (Atlas, region sin1) ----------
# Tạo database riêng `so_no` + user riêng, KHÔNG dùng chung cluster với project khác.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/so_no?retryWrites=true&w=majority
MONGODB_DB=so_no

# ---------- Admin ----------
# Sinh bằng: npm run hash-password -- "mat-khau-cua-ban"
ADMIN_PASSWORD_HASH=scrypt:16384:8:1:<salt-hex>:<hash-hex>

# ---------- Session ----------
# 64 ký tự hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=<64-hex-ký-tự>

# ---------- URL ----------
# URL công khai của FRONTEND (dùng để dựng link chia sẻ /s/{code})
APP_BASE_URL=https://so-no-fe.vercel.app
# Origin được phép gọi API ghi (phân tách bằng dấu phẩy) — thêm domain FE
ALLOWED_ORIGINS=http://localhost:3000,https://so-no-fe.vercel.app
