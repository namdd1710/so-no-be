# ---------- MongoDB (Atlas, region sin1) ----------
# Tạo database riêng `so_no` + user riêng, KHÔNG dùng chung cluster với project khác.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/so_no?retryWrites=true&w=majority
MONGODB_DB=so_no
# Tuỳ chọn: chỉ định DNS cho driver, dùng khi máy local báo
# `querySrv ECONNREFUSED` (Windows hay gặp). Production để trống.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# ---------- Admin ----------
# Mật khẩu đăng nhập (chữ thường). Đây là mật khẩu KHỞI TẠO: khi bạn đổi mật khẩu
# bằng "Quên mật khẩu?" thì mật khẩu mới được lưu trong Mongo và thay thế giá trị này.
ADMIN_PASSWORD=mat-khau-cua-ban

# Key để đổi mật khẩu khi quên — bạn tự đặt chuỗi bí mật, càng dài càng tốt.
# Nhập đúng value này + mật khẩu mới thì mới đổi được. Để trống = tắt tính năng.
# Gợi ý sinh: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_RECOVERY_KEY=<chuoi-bi-mat-ban-tu-dat>

# ---------- Session ----------
# 64 ký tự hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=<64-hex-ky-tu>

# ---------- Nhận tiền (QR MoMo) ----------
# Số điện thoại ví MoMo nhận tiền. Không đặt = dùng 0352611710.
MOMO_PHONE=0352611710
# Tên hiển thị kèm số ví (không bắt buộc).
MOMO_NAME=
# Số tài khoản ví MoMo dạng `99MM…` (18 ký tự), lấy ở app MoMo → Nhận tiền →
# xem chuỗi trong mã QR. CÓ số này thì QR chứa sẵn số tiền + nội dung và quét
# được bằng app ngân hàng lẫn MoMo; không có thì QR là link chuyển tiền MoMo.
MOMO_WALLET_ACCOUNT=

# ---------- URL ----------
# URL công khai của FRONTEND (dùng để dựng link chia sẻ /s/{code})
APP_BASE_URL=https://so-no-fe.vercel.app
# Origin được phép gọi API ghi (phân tách bằng dấu phẩy) — thêm domain FE
ALLOWED_ORIGINS=http://localhost:3000,https://so-no-fe.vercel.app
